{
	admin off
	persist_config off
	auto_https off
	{$CADDY_GLOBAL_OPTIONS}

	log {
		format json
		output stderr
		level INFO
	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

:{$PORT:80} {
	root * /app
	encode zstd br gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@private path /.git* /.env* /backup* /backup/* /logs* /logs/* /var* /var/* /db* /db/* /dbase* /dbase/* /update* /update/* /tools* /tools/* /tests* /tests/* /cli* /cli/* /deploy* /deploy/* /docs* /docs/* /composer.json /composer.lock /package.json /package-lock.json /phpunit.xml /phpstan.neon.dist /railway.json /railpack.json /Dockerfile /Dockerfile* /docker* /docker/* *.sql *.log *.bak *.patch
	respond @private 403

	@static path *.css *.js *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.ttf *.otf *.woff *.woff2 *.eot
	header @static Cache-Control "public, max-age=2592000"

	php_server
}
