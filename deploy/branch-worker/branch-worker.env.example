# POSMAIN branch worker environment template.
# Copy to /etc/posmain/branch-worker.env or .env.branch-worker. Keep outside git.

POSMAIN_ROLE=branch
# Local/branch main login uses PIN. Cloud/router must use password (pin is rejected).
POSMAIN_MAIN_AUTH_MODE=pin
POSMAIN_PIN_SECRET=replace-with-strong-random-pin-hmac-secret
POSMAIN_CONFIG_ENCRYPTION_KEY=replace-with-strong-random-config-key

POSMAIN_DB_HOST=127.0.0.1
POSMAIN_DB_PORT=3306
POSMAIN_DB_NAME=kody2
POSMAIN_DB_USER=posmain
POSMAIN_DB_PASS=replace-with-db-password

# Automatic branch-to-hosted upload is enabled. Generic hosted-to-branch POS edits
# stay disabled; manual recovery uses tools/restore_branch_from_hosted.php.
POSMAIN_SYNC_OUTBOX_ENABLED=1
POSMAIN_BRANCH_SYNC_ENABLED=1
POSMAIN_SYNC_WORKER_ENABLED=1
POSMAIN_CLOUD_PULL_ENABLED=0

# Prefer saving these via Settings UI (sync_runtime_settings). Set here only if the worker
# cannot read them from the shop database.
# POSMAIN_BRANCH_UUID=
# POSMAIN_CLOUD_BASE_URL=
# POSMAIN_BRANCH_SYNC_SECRET=
