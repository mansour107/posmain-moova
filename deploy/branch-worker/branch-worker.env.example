# POSMAIN branch worker environment template.
# Copy to /etc/posmain/branch-worker.env, .env.branch-worker, or the platform-specific service environment.
# Keep the real copied file outside git.

POSMAIN_ROLE=branch
POSMAIN_TIMEZONE=Africa/Cairo
POSMAIN_CONFIG_ENCRYPTION_KEY=replace-with-strong-random-config-key
POSMAIN_DISABLE_UI_RUNTIME_CONFIG=0

POSMAIN_DB_HOST=127.0.0.1
POSMAIN_DB_PORT=3306
POSMAIN_DB_NAME=kody2
POSMAIN_DB_USER=posmain
POSMAIN_DB_PASS=replace-with-db-password
POSMAIN_DB_CHARSET=utf8mb4

POSMAIN_BRANCH_UUID=replace-with-branch-uuid
POSMAIN_BRANCH_NAME=replace-with-shop-branch-name
POSMAIN_POS_TENANT=0
POSMAIN_POS_BRANCH=0
POSMAIN_CLOUD_BASE_URL=https://cloud.example.com
POSMAIN_BRANCH_SYNC_SECRET=replace-with-protected-sync-secret

POSMAIN_SYNC_WORKER_ENABLED=1
POSMAIN_BRANCH_SYNC_ENABLED=1
POSMAIN_SYNC_OUTBOX_ENABLED=1
POSMAIN_MOOVA_POLLER_ENABLED=1
POSMAIN_MOOVA_APPLY_ENABLED=0
POSMAIN_MENU_SYNC_ENABLED=0

POSMAIN_SYNC_HTTP_CONNECT_TIMEOUT_MS=1000
POSMAIN_SYNC_HTTP_TIMEOUT_MS=5000
