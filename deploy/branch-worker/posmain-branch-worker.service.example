[Unit]
Description=POSMAIN Branch Sync Worker
After=network-online.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/posmain
EnvironmentFile=/etc/posmain/branch-worker.env
ExecStart=/usr/bin/php /opt/posmain/tools/local_sync_worker_supervisor.php --loop --strict --sleep=5 --status-file=/var/lib/posmain/branch-worker-status.json --pid-file=/run/posmain/branch-worker.pid
Restart=always
RestartSec=5
RuntimeDirectory=posmain
StateDirectory=posmain
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
