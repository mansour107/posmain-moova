[Unit]
Description=POSMAIN local printer bridge
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__POSMAIN_ROOT__
EnvironmentFile=__PRINT_ENV_FILE__
ExecStart=__PHP_BINARY__ __POSMAIN_ROOT__/tools/print_bridge.php --listen=__BRIDGE_LISTEN__ --secret-file=__BRIDGE_SECRET_FILE__ --state-dir=__BRIDGE_STATE_DIR__
Restart=always
RestartSec=3
User=__SERVICE_USER__
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
