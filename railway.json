{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "healthcheckPath": "/api/ready.php",
    "healthcheckTimeout": 60,
    "overlapSeconds": 30,
    "drainingSeconds": 15,
    "startCommand": "sh -c 'mkdir -p /app/logs /app/uploads /app/var/sessions && chmod -R 777 /app/logs /app/uploads /app/var && /start-container.sh'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
