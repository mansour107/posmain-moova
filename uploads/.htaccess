# Uploaded files are public content, never executable application code.
# Keep static assets readable while disabling Apache execution mechanisms.
Options -Indexes -ExecCGI -Includes

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
</IfModule>

<FilesMatch "(?i)\.(php[0-9]*|phtml|phar|phps|cgi|pl|py|rb|sh|bash|csh|ksh|jsp|asp|aspx|shtml)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
