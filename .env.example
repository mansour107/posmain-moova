# POSMAIN environment template. Copy to .env and set real secrets.
# Never commit a populated .env file.
#
# Sync identity (UUID, secret, cloud URL) and sync toggles belong in Settings UI
# (sync_runtime_settings), not here — except for branch-worker env files below.
#
# --- Local branch (POSMAIN_ROLE=branch) ---
# POSMAIN_ENV=local
# POSMAIN_ROLE=branch
# POSMAIN_MAIN_AUTH_MODE=pin
# POSMAIN_PIN_SECRET=replace-with-strong-random-pin-hmac-secret
# POSMAIN_INACTIVITY_LOCK_SECONDS=300
# POSMAIN_HEARTBEAT_GRACE_SECONDS=60
# POSMAIN_PUBLIC_BASE_URL=http://127.0.0.1:8010
# POSMAIN_CONFIG_ENCRYPTION_KEY=replace-with-strong-random-config-key
# POSMAIN_DB_HOST=127.0.0.1
# POSMAIN_DB_PORT=3307
# POSMAIN_DB_USER=root
# POSMAIN_DB_PASS=
# POSMAIN_DB_NAME=kody2
#
# --- Hosted cloud / multishop (POSMAIN_ROLE=cloud) ---
# POSMAIN_ENV=production
# POSMAIN_ROLE=cloud
# POSMAIN_MAIN_AUTH_MODE=password
# Never set POSMAIN_MAIN_AUTH_MODE=pin on cloud/router — startup/health fail closed (MAIN_AUTH_MODE_UNSAFE).
# POSMAIN_PUBLIC_BASE_URL=https://hosted.example.com
# POSMAIN_CONFIG_ENCRYPTION_KEY=replace-with-strong-random-config-key
# POSMAIN_ROUTER_ENABLED=1
# POSMAIN_ROUTER_DB_HOST=127.0.0.1
# POSMAIN_ROUTER_DB_PORT=3306
# POSMAIN_ROUTER_DB_USER=posmain_router
# POSMAIN_ROUTER_DB_PASS=replace-with-router-db-password
# POSMAIN_ROUTER_DB_NAME=posmain_router
# POSMAIN_DB_HOST=127.0.0.1
# POSMAIN_DB_PORT=3306
# POSMAIN_DB_USER=root
# POSMAIN_DB_PASS=
# POSMAIN_DB_NAME=posmain_router
#
# --- Optional (any install) ---
# POSMAIN_TIMEZONE=Africa/Cairo
# POSMAIN_PRODUCTION_MODE=0
# POSMAIN_STATUS_TOKEN=change-me-status-token
# POSMAIN_DISABLE_UI_RUNTIME_CONFIG=0
# POSMAIN_DISABLE_BRANCH_ENV_FILE_FALLBACK=1
# POSMAIN_MOOVA_MODE=direct_widget
# POSMAIN_MOOVA_BASE_URL=https://withmoova.com
# POSMAIN_ENABLE_LEGACY_DEBUG_ROUTES=0
# POSMAIN_PREPARATION_FIELDS_ENABLED=1
# Printing defaults to the existing browser dialog. Set silent only after
# configuring printer routes and completing the physical-printer acceptance gate.
# POSMAIN_PRINT_MODE=legacy
# POSMAIN_PRINT_SIMULATOR_DIR=/var/lib/posmain/print-simulator
# POSMAIN_PRINT_NETWORK_TIMEOUT_MS=3000
# POSMAIN_PRINT_WORKER_LOCK_SECONDS=45
# POSMAIN_PRINT_RETRY_DELAY_SECONDS=15
# Remote updates: edit config/update_channel.php; optional override:
# POSMAIN_UPDATE_CHANNEL_URL=https://your-update-server.example
#
# --- Recipe GL account mappings (optional; chart codes 42/123/41 resolve when unset) ---
# POSMAIN_RECIPE_DEFAULT_COGS_ACCOUNT_ID=16
# POSMAIN_RECIPE_RAW_INVENTORY_ACCOUNT_ID=20
# POSMAIN_RECIPE_PREPARED_INVENTORY_ACCOUNT_ID=20
# POSMAIN_RECIPE_PACKAGING_INVENTORY_ACCOUNT_ID=20
# POSMAIN_RECIPE_WASTE_EXPENSE_ACCOUNT_ID=15
# POSMAIN_RECIPE_PRODUCTION_VARIANCE_ACCOUNT_ID=15
#
# --- Financial exact-money core (always on; no legacy dual-mode toggle) ---
# POSMAIN_FINANCIAL_REQUIRE_BALANCE_CACHE=1
# POSMAIN_FINANCIAL_REQUIRE_CASH_DRAWER_LINK=1
# POSMAIN_INVENTORY_STRICT_STOCK=1
