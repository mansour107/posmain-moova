# POSMAIN runtime environment template.
# Copy to .env for local/staging deployments. Never commit real secrets.

POSMAIN_ENV=local
POSMAIN_ROLE=branch
POSMAIN_TIMEZONE=Africa/Cairo
POSMAIN_PUBLIC_BASE_URL=http://127.0.0.1:8010
# Remote update channel: edit config/update_channel.php (ships with code updates).
# Optional local override only: POSMAIN_UPDATE_CHANNEL_URL=https://your-update-server.example
POSMAIN_UPDATE_PHP_BIN=/usr/bin/php
POSMAIN_UPDATE_RUN_AS=posmain
POSMAIN_UPDATE_WORKER_WRAPPER=/usr/local/bin/posmain-update-worker
POSMAIN_UPDATE_PHP_FPM_RELOAD_CMD=systemctl reload php8.5-fpm
POSMAIN_UPDATE_GIT_BRANCH=main
POSMAIN_UPDATE_GIT_REMOTE=origin
POSMAIN_PRODUCTION_MODE=0
POSMAIN_STATUS_TOKEN=change-me-status-token
POSMAIN_CONFIG_ENCRYPTION_KEY=replace-with-strong-random-config-key
POSMAIN_DISABLE_UI_RUNTIME_CONFIG=0
POSMAIN_SESSION_LIFETIME_SECONDS=86400
POSMAIN_SESSION_IDLE_SECONDS=86400
POSMAIN_SESSION_ABSOLUTE_SECONDS=86400

POSMAIN_DB_HOST=127.0.0.1
POSMAIN_DB_PORT=3307
POSMAIN_DB_USER=root
POSMAIN_DB_PASS=
POSMAIN_DB_NAME=kody2
POSMAIN_DB_CHARSET=utf8mb4

# Optional hosted single-domain router. Leave disabled for normal local POS.
POSMAIN_ROUTER_ENABLED=0
POSMAIN_ROUTER_REQUIRE_ENCRYPTION=1
POSMAIN_ROUTER_DB_HOST=127.0.0.1
POSMAIN_ROUTER_DB_PORT=3306
POSMAIN_ROUTER_DB_USER=posmain_router
POSMAIN_ROUTER_DB_PASS=replace-with-router-db-password
POSMAIN_ROUTER_DB_NAME=posmain_router
POSMAIN_ROUTER_DB_CHARSET=utf8mb4

POSMAIN_POS_TENANT=0
POSMAIN_POS_BRANCH=0
POSMAIN_BRANCH_UUID=
POSMAIN_BRANCH_NAME=

POSMAIN_ENABLE_LEGACY_DEBUG_ROUTES=0
POSMAIN_ENABLE_LEGACY_OFFLINE_PROTOTYPE=0
POSMAIN_MOOVA_MODE=direct_widget
POSMAIN_ENABLE_MOOVA_DIRECT_APPLY=1
POSMAIN_ENABLE_MOOVA_QUEUED_APPLY=1
POSMAIN_ENABLE_SYNC_OUTBOX=1
POSMAIN_ENABLE_CLOUD_SYNC=0
POSMAIN_ENABLE_KDS=0
POSMAIN_ENABLE_MODIFIERS=0
POSMAIN_ENABLE_NUTRITION=0
POSMAIN_ENABLE_AI_ANALYTICS=0
POSMAIN_ENABLE_ETA_ERECEIPT=0

# Recipe/BOM system. Defaults to real ingredient consumption so recipe sales
# deduct ingredient inventory instead of running in shadow-only mode.
POSMAIN_ENABLE_RECIPES=1
POSMAIN_RECIPE_MODE=consume_pilot
POSMAIN_RECIPE_SHADOW_LEDGER=0
POSMAIN_RECIPE_RESERVATIONS=0
POSMAIN_RECIPE_CONSUMPTION=1
POSMAIN_RECIPE_ACCOUNTING=0
POSMAIN_RECIPE_AVAILABILITY=0
POSMAIN_RECIPE_MOOVA_SYNC=0
POSMAIN_RECIPE_STRICT_STOCK=0
POSMAIN_RECIPE_COST_PUBLIC_PAYLOADS=0
POSMAIN_RECIPE_PILOT_POS_BRANCH=0
POSMAIN_RECIPE_DEFAULT_COGS_ACCOUNT_ID=0
POSMAIN_RECIPE_RAW_INVENTORY_ACCOUNT_ID=0
POSMAIN_RECIPE_PREPARED_INVENTORY_ACCOUNT_ID=0
POSMAIN_RECIPE_PACKAGING_INVENTORY_ACCOUNT_ID=0
POSMAIN_RECIPE_WASTE_EXPENSE_ACCOUNT_ID=0
POSMAIN_RECIPE_PRODUCTION_VARIANCE_ACCOUNT_ID=0
POSMAIN_RECIPE_DEFAULT_RESERVATION_MINUTES=90
POSMAIN_RECIPE_DEFAULT_SAFETY_STOCK_QTY=0
POSMAIN_RECIPE_REFUND_STOCK_POLICY=waste
POSMAIN_RECIPE_ALLOW_NEGATIVE_STOCK_WITH_APPROVAL=0
POSMAIN_RECIPE_PRODUCTION_VARIANCE_POLICY=adjust_unit_cost
POSMAIN_RECIPE_PILOT_ITEM_IDS=
POSMAIN_RECIPE_PILOT_CATEGORY_IDS=

# Inventory ledger cutover. `live` makes inventory_item_balances the stock truth.
POSMAIN_INVENTORY_LEDGER_MODE=live
POSMAIN_INVENTORY_LEGACY_MIRROR=0
POSMAIN_INVENTORY_STRICT_STOCK=0
POSMAIN_INVENTORY_RESERVATIONS=0
POSMAIN_INVENTORY_ACCOUNTING=0
POSMAIN_INVENTORY_AVAILABILITY=0
POSMAIN_INVENTORY_SYNC=0
POSMAIN_INVENTORY_COST_PUBLIC_PAYLOADS=0

POSMAIN_CLOUD_BASE_URL=
POSMAIN_BRANCH_SYNC_SECRET=
POSMAIN_SYNC_STATUS_TOKEN=
POSMAIN_SYNC_WORKER_ENABLED=1
POSMAIN_SYNC_SHADOW_MODE=0
POSMAIN_CLOUD_LEGACY_POS_MIRROR_ENABLED=0
POSMAIN_CLOUD_TO_BRANCH_PUBLISH_ENABLED=0
POSMAIN_CLOUD_PULL_ENABLED=1
POSMAIN_MOOVA_APPLY_ENABLED=1
POSMAIN_MOOVA_APPLY_USER_ID=1
